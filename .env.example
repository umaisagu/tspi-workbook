# Copy to .env for local development (never commit .env).
# On Vercel set these in Project → Settings → Environment Variables (see DEPLOY.md).

# Postgres. Locally both point at the same database.
# On Vercel + Neon: DATABASE_URL = pooled connection (host contains "-pooler"),
#                   DIRECT_URL   = direct connection (used only by `prisma migrate deploy`).
DATABASE_URL="postgresql://tspi:tspi@localhost:5432/tspi_dev"
DIRECT_URL="postgresql://tspi:tspi@localhost:5432/tspi_dev"

# Session encryption key, at least 32 characters: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app, used in password-reset e-mails.
APP_URL="http://localhost:3000"

# Comma-separated e-mail domains allowed to register.
ALLOWED_EMAIL_DOMAINS="siswa.unimas.my,unimas.my"

# SMTP for password-reset e-mails. Required on Vercel; optional locally
# (without SMTP_HOST the reset link is printed to the server log).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TSPi Workbook <no-reply@example.com>"
SMTP_SECURE="false"

# GitHub REST API token (read-only, public_repo or fine-grained read access to team repos).
# Optional: without it the GitHub columns are hidden.
GITHUB_TOKEN=""

# Shared secret for the daily cron route (/api/cron/github). Required on Vercel.
CRON_SECRET=""
